{
    "code-runner.executorMap": {
        "c": "cd \"$dir\"; clang \"$fileName\" -o \"$workspaceRoot/bin/$fileNameWithoutExt.exe\"; if ($?) { & \"$workspaceRoot/bin/$fileNameWithoutExt.exe\" }"
    },
    "code-runner.clearPreviousOutput": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.runInTerminal": true,
    "code-runner.preserveFocus": false,
    "files.watcherExclude": {
        "**/bin/**": true,
        "**/*.exe": true,
        "**/*.tmp*": true,
        "**/*.exe.tmp*": true
    },
    "files.exclude": {
        "**/*.exe": true,
        "**/*.tmp*": true,
        "**/*.exe.tmp*": true
    },
    "search.exclude": {
        "**/bin": true,
        "**/*.exe": true,
        "**/*.tmp*": true,
        "**/*.exe.tmp*": true
    }
}
