{
    "code-runner.executorMap": {
        "c": "cd \"$dir\"; clang -c \"$fileName\" -o \"$fileNameWithoutExt.obj\"; if ($?) { clang \"$fileNameWithoutExt.obj\" -o \"$fileNameWithoutExt.exe\"; if ($?) { & \".\\$fileNameWithoutExt.exe\" } }"
    },
    "code-runner.clearPreviousOutput": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.runInTerminal": true,
    "code-runner.preserveFocus": false,
    "files.watcherExclude": {
        "**/*.tmp*": true,
        "**/*.exe.tmp*": true
    },
    "files.exclude": {
        "**/*.tmp*": true,
        "**/*.exe.tmp*": true
    },
    "search.exclude": {
        "**/*.tmp*": true,
        "**/*.exe.tmp*": true
    }
}
